{
  "name": "notex-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "migrate": "node --env-file-if-exists=.env db/migrate.js",
    "hash-password": "node scripts/hash-password.js",
    "test": "node --env-file-if-exists=.env.test --test"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17"
  }
}
