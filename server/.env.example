# Copy to .env and fill in. Never commit .env.

# Neon connection string (Neon dashboard -> Connect). Keep ?sslmode=require.
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/notex?sslmode=require

PORT=8000

# Long random string used to sign login cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Google sign-in (D16). OAuth client ID from Google Cloud Console ->
# APIs & Services -> Credentials (type "Web application"). Not a secret.
GOOGLE_CLIENT_ID=

# Your Google email: your first sign-in takes over the notes created before
# multi-user login existed.
OWNER_EMAIL=

# Optional: AI requests per user per day (default 150).
# AI_DAILY_LIMIT=150

# Cloudflare Workers AI (folder suggestions, search by meaning). Optional:
# without them the app works, AI features are just off.
# Account ID: the 32 characters in dash.cloudflare.com/<account id>/home
# Token: My Profile -> API Tokens -> "Workers AI" template, Account Resources: your account
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
