# Copy to .env and fill in. Never commit .env.

# Neon connection string (Neon dashboard -> Connect). Keep ?sslmode=require.
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/notex?sslmode=require

PORT=8000

# Long random string used to sign login cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Hash of your login password. Generate with:
#   npm run hash-password -- "your password"
# Wrap it in single quotes: the hash contains '$' characters.
APP_PASSWORD_HASH=
