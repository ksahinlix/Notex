# Copy to deploy/.env and fill in. Never commit .env.
# The same variables as server/.env.example, minus DATABASE_URL, which
# compose.yaml builds from POSTGRES_PASSWORD.

# Password of the database inside Docker. Any long random string:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Copy these from Render (Environment tab) so sessions and notification
# subscriptions keep working after the move.
SESSION_SECRET=
GOOGLE_CLIENT_ID=
OWNER_EMAIL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Guards /api/reminders/due (called by the `clock` service) and /api/backup
# (fetched by scripts/pull-backup.ps1).
CRON_SECRET=

# Optional: AI (D15).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# AI_DAILY_LIMIT=150

# Optional: when the nightly backup runs and how long it is kept.
# TZ=Europe/Istanbul
# BACKUP_AT=03:00
# BACKUP_KEEP_DAYS=14
# Host port on 127.0.0.1 that Tailscale Funnel points at.
# NOTEX_PORT=8000
